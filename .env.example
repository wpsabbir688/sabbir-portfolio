# ---------------------------------------------------------------------------
# Environment configuration example. Copy to ".env" for local overrides.
# No secrets belong in the frontend bundle — anything prefixed with VITE_
# is public. Never commit real API keys here.
# ---------------------------------------------------------------------------

# Optional: the URL/name shown in canonical + Open Graph tags once the
# production domain is known.
VITE_SITE_URL=

# The contact form endpoint is configured in src/utils/constants.js
# (CONTACT_ENDPOINT). Point it at your own form backend / email provider
# endpoint (e.g. a serverless function) — never embed private API keys
# in client-side code.
